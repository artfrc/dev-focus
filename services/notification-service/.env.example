PORT=3003
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
INTERNAL_API_KEY=troque-por-uma-chave-secreta-interna
TZ=America/Sao_Paulo

# SMTP para envio de e-mails (lembrete diario + alerta de prazo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM="DevFocus <no-reply@devfocus.app>"

# Horarios (cron, formato "min hora * * *") dos jobs diarios
CRON_LEMBRETE_DIARIO="0 20 * * *"
CRON_VERIFICAR_PRAZOS="0 8 * * *"
